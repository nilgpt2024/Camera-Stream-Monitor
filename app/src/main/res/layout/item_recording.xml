<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#0A000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- 缩略图 -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="60dp"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_video_file"
                android:background="#F5F5F5" />

            <!-- 播放按钮覆盖 -->
            <ImageView
                android:id="@+id/btnPlay"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_circle"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- 时长标签（可选） -->
            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="bottom|end"
                android:background="#CC000000"
                android:paddingHorizontal="6dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 文件信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="video_2024-01-15_10-30-00.mp4"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvFileInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2024-01-15 10:30"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />

            <TextView
                android:id="@+id/tvFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="25.5 MB"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:background="@drawable/tag_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <!-- 删除按钮 -->
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_delete"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#BDBDBD"
            android:contentDescription="删除" />

        <!-- 上传到 WebDAV 按钮 -->
        <ImageView
            android:id="@+id/btnUpload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_stream"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#4CAF50"
            android:contentDescription="@string/webdav_upload_title" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
