<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MonitorActivity">

    <!-- Main camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Secondary camera preview (PiP) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewBack"
        android:layout_width="140dp"
        android:layout_height="187dp"
        android:layout_margin="20dp"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- SurfaceView for streaming -->
    <FrameLayout
        android:id="@+id/surfaceContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 时间水印 - 左上角显示 (醒目位置) -->
    <com.andwin.video.streamer.TimeWatermarkView
        android:id="@+id/timeWatermark"
        android:layout_width="220dp"
        android:layout_height="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="70dp"
        android:background="#00000000"
        android:elevation="20dp"
        android:padding="8dp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Control Bar - Glassmorphism -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_glass_top_bar"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back button with glass effect -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="@color/glass_background"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_border">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                app:tint="@color/on_surface" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Camera info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCameraName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实时预览"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResolutionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="480×640 @ 24fps"
                android:textColor="#B0B0B0"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Status badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_status_indicator">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_status_ready" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="就绪"
                android:textColor="@color/status_ready"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dual camera indicator -->
    <TextView
        android:id="@+id/dualCameraIndicator"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="双摄模式"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_pill_secondary"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Recording time indicator -->
    <LinearLayout
        android:id="@+id/recordingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_recording_indicator"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/dualCameraIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_recording_pulse" />

        <TextView
            android:id="@+id/tvRecordingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="00:00:00"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Streaming indicator -->
    <TextView
        android:id="@+id/streamingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="推流中"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_streaming_indicator"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/recordingIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Control Panel - Glassmorphism -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp"
        android:paddingTop="20dp"
        android:paddingHorizontal="20dp"
        android:background="@drawable/bg_glass_bottom_panel"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Primary controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Record button - Large prominent button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnRecordContainer"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1.4"
                app:cardCornerRadius="34dp"
                app:cardBackgroundColor="@color/error_container"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/recordDot"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/circle_record_idle" />

                    <TextView
                        android:id="@+id/btnRecordText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="0dp"
                        android:text="录"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stream button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnStreamContainer"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FF0891B2"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_stream"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/btnStreamText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="0dp"
                        android:text="推"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secondary action buttons -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSwitchCamera"
                android:layout_width="68dp"
                android:layout_height="68dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/glass_background"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_border"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="10dp">

                <ImageButton
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_flip_camera"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="切换摄像头"
                    app:tint="@android:color/white" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCapture"
                android:layout_width="68dp"
                android:layout_height="68dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/glass_background"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_border"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="10dp">

                <ImageButton
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_photo_camera"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="拍照"
                    app:tint="@android:color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Dual camera mode button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnDualCamera"
                android:layout_width="68dp"
                android:layout_height="68dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FF7C3AED"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">

                <ImageButton
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_videocam"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="双摄模式"
                    app:tint="@android:color/white" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Hint text -->
        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="点击红色按钮开始录制"
            android:textColor="#909090"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
