<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MonitorActivity">

    <!-- Main camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Secondary camera preview (PiP) - 横屏适配：更宽更矮 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewBack"
        android:layout_width="180dp"
        android:layout_height="120dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- SurfaceView for streaming -->
    <FrameLayout
        android:id="@+id/surfaceContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 时间水印 - 右下角显示 -->
    <com.andwin.video.streamer.TimeWatermarkView
        android:id="@+id/timeWatermark"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:background="#00000000"
        android:elevation="20dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textAlignment="textEnd"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Control Bar - 横屏更紧凑 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_glass_top_bar"
        android:elevation="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back button -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@color/glass_background"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_border">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                app:tint="@color/on_surface" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Camera info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCameraName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_preview"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResolutionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="480×640 @ 24fps"
                android:textColor="#B0B0B0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Status badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_status_indicator">

            <View
                android:id="@+id/statusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/circle_status_ready" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/ready"
                android:textColor="@color/status_ready"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 横屏指示器区域 - 水平排列，紧贴顶栏下方 -->
    <LinearLayout
        android:id="@+id/indicatorBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Dual camera indicator -->
        <TextView
            android:id="@+id/dualCameraIndicator"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="@string/dual_mode_indicator"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_pill_secondary"
            android:visibility="gone"
            android:layout_marginEnd="6dp" />

        <!-- Recording time indicator -->
        <LinearLayout
            android:id="@+id/recordingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_recording_indicator"
            android:visibility="gone"
            android:layout_marginEnd="6dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_recording_pulse" />

            <TextView
                android:id="@+id/tvRecordingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="00:00:00"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Streaming indicator -->
        <TextView
            android:id="@+id/streamingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="@string/streaming_active"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_streaming_indicator"
            android:visibility="gone"
            android:layout_marginEnd="6dp" />

        <!-- 手检测状态 -->
        <LinearLayout
            android:id="@+id/handDetectionPanel"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_hand_detection_panel"
            android:visibility="gone"
            android:layout_marginEnd="6dp">

            <View
                android:id="@+id/handIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_status_ready" />

            <TextView
                android:id="@+id/tvHandStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="未检测到手部"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 人脸检测状态 -->
        <LinearLayout
            android:id="@+id/faceDetectionPanel"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_hand_detection_panel"
            android:visibility="gone"
            android:layout_marginEnd="6dp">

            <View
                android:id="@+id/faceIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_status_ready" />

            <TextView
                android:id="@+id/tvFaceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="未检测到人脸"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 姿态检测状态 -->
        <LinearLayout
            android:id="@+id/poseDetectionPanel"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_hand_detection_panel"
            android:visibility="gone"
            android:layout_marginEnd="6dp">

            <View
                android:id="@+id/poseIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_status_ready" />

            <TextView
                android:id="@+id/tvPoseStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="未检测到人体"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 人像分割状态 -->
        <LinearLayout
            android:id="@+id/segmentationPanel"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_hand_detection_panel"
            android:visibility="gone">

            <View
                android:id="@+id/segmentationIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_status_ready" />

            <TextView
                android:id="@+id/tvSegmentationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="人像分割中..."
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Control Panel - 横屏紧凑布局：单行排列所有控件 -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:background="@drawable/bg_glass_bottom_panel"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 左侧：录制按钮（紧凑） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnRecordContainer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.2"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/error_container"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/recordDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/circle_record_idle" />

                <TextView
                    android:id="@+id/btnRecordText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_record_label"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 推流按钮（紧凑） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnStreamContainer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="0.8"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FF0891B2"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_stream"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/btnStreamText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/btn_stream_label"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 分隔线 -->
        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:background="#40FFFFFF"
            android:layout_marginEnd="12dp" />

        <!-- 右侧辅助按钮组 - 横向紧凑排列 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSwitchCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="@color/glass_background"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_border"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_flip_camera"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="@string/switch_camera"
                app:tint="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCapture"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="@color/glass_background"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_border"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_photo_camera"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="@string/capture_photo"
                app:tint="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnDualCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="#FF7C3AED"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_videocam"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="@string/dual_mode_toggle"
                app:tint="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnHandDetection"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="@color/glass_background"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_border"
            android:clickable="true"
            android:focusable="true">

            <ImageButton
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_hand_detection"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="@string/start_detection_btn"
                app:tint="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Hint text -->
        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/recording_hint"
            android:textColor="#909090"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
